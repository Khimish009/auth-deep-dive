# root = true означает, что это главный файл конфигурации и поиск выше по папкам прекращается
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Специфичные настройки для файлов разметки (если нужно)
[*.md]
trim_trailing_whitespace = false

# Настройки для конфигурационных файлов JSON / YAML
[{*.json,*.yml,*.yaml}]
indent_size = 2
